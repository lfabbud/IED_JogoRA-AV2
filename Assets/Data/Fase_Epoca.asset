  brandLogo: {fileID: 21300000, guid: be9acbd75cdea4e82ae90634a800747e, type: 3}
  introText: "Ajude a Lu a chegar ao final deste percurso.\n\nQuanto mais moedas
    conseguir coletar, mais desconto ir\xE1 conseguir no produto especialmente escolhido
    para voc\xEA!"
  rewardMessage: e ganhou <b>{desconto}%</b> de desconto em um <b>protetor solar!</b>
  couponMessage: "Apresente este <b>QR Code</b> \ne ganhe <b>{desconto}%</b> de desconto\nno
    produto <b>{marca}</b>."
  scannerUnlockedMessage: "O jogo da {marca} \nfoi desbloqueado!"
  scannerRevisitMessage: Jogo da {marca}
